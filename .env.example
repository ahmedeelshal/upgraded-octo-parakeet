# MAAK v2 configuration. Never commit or share your real .env file.
HOST=127.0.0.1
PORT=4173

# Optional custom persistent paths
# MAAK_DB_PATH=/absolute/path/to/maak.sqlite
# MAAK_BACKUP_DIR=/absolute/path/to/maak-backups
MAAK_BACKUP_KEEP=14
MAAK_SESSION_DAYS=14

# Set true ONLY when binding to a non-loopback host behind a trusted HTTPS reverse proxy.
# The proxy must terminate TLS and set X-Forwarded-Proto correctly.
MAAK_TRUST_PROXY=false

# Online AI (OpenAI-compatible Chat Completions API); usage may incur charges.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Web Push for reminders while the app is closed; requires HTTPS.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
